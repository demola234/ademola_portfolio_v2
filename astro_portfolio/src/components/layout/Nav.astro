---
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const navLinks = [
  { href: '/',           label: 'home' },
  { href: '/writing',    label: 'writing' },
  { href: '/projects',   label: 'projects' },
  { href: '/experience', label: 'experience' },
  { href: '/notes',      label: 'notes' },
];

const rightLinks = [
  { href: 'https://youtube.com/@CodeWithDemola',  label: 'youtube',  external: true },
  { href: 'https://github.com/demola234',         label: 'github',   external: true },
  { href: 'https://medium.com/@ademolakolawole',  label: 'medium',   external: true },
  { href: 'https://docs.google.com/document/d/1_f1ufm9wkCCEWFMyIKFfso7bRFG-mB3YnMMTPIogMkw/edit?usp=sharing', label: 'resume ↗', external: true },
];
---

<nav class="nav-chips">
  {navLinks.map(({ href, label }) => (
    <a
      href={href}
      class={`navchip ${isActive(href) ? 'navchip--active' : ''}`}
      aria-current={isActive(href) ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
  <span class="nav-spacer" aria-hidden="true" />
  {rightLinks.map(({ href, label, external }) => (
    <a
      href={href}
      class="navchip navchip--right"
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {label}
    </a>
  ))}
  <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="true" aria-label="Click sounds on — mute">
    <svg class="sound-toggle__on" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 6h2l3-2.5v9L5 10H3z" fill="currentColor" /><path d="M10.5 5.5a3.5 3.5 0 0 1 0 5M12 4a5.5 5.5 0 0 1 0 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
    <svg class="sound-toggle__off" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 6h2l3-2.5v9L5 10H3z" fill="currentColor" /><path d="M10.5 6.5l3 3M13.5 6.5l-3 3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
  </button>
</nav>

<style>
  /* Glaze: pill links; the current page sits on the paper pill. No track behind the group. */
  .nav-chips {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 16px 0;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line-faint);
  }

  .nav-spacer {
    flex: 1;
  }

  .navchip {
    display: inline-flex;
    align-items: center;
    height: var(--control);
    padding: 0 12px;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-state) var(--ease-out), color var(--dur-state) var(--ease-out);
  }

  .navchip:hover {
    background: var(--hover);
    color: var(--text-1);
  }

  .navchip--active,
  .navchip--active:hover {
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text-1);
  }

  /* Click-sound mute toggle — a ghost icon button */
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control);
    height: var(--control);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition: background-color var(--dur-state) var(--ease-out), color var(--dur-state) var(--ease-out);
  }
  .sound-toggle:hover { background: var(--hover); color: var(--text-1); }
  .sound-toggle[data-state="off"] .sound-toggle__on,
  .sound-toggle:not([data-state="off"]) .sound-toggle__off { display: none; }

  @media (max-width: 600px) {
    .sound-toggle { margin-left: auto; }
    .nav-spacer { display: none; }
    .navchip--right { display: none; }
  }
</style>
