---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Comments from '../../components/blogs/Comments';
import audioManifest from '../../data/audio.json';

type AudioEntry = { file: string; timings?: string; hash: string; durationSec: number };

export async function getStaticPaths() {
  const posts = (await getCollection('writing'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: i < posts.length - 1 ? posts[i + 1] : null,
      next: i > 0               ? posts[i - 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
});

const audio = (audioManifest as Record<string, AudioEntry>)[post.slug];
const SPEEDS = [0.75, 1, 1.25, 1.5, 2];
const fmtTime = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

const twitterText = encodeURIComponent(post.data.title);
const pageUrl = encodeURIComponent(`https://demola.dev/writing/${post.slug}`);
---

<BaseLayout
  title={`${post.data.title} — Ademola Kolawole`}
  description={post.data.excerpt}
  ogImage={post.data.image_url}
  ogType="article"
>

  <!-- breadcrumb status bar -->
  <div class="art-statusbar">
    <a href="/writing" class="art-back mono">← demola.dev / writing</a>
    <span class="art-read mono">{post.data.readMins} min read</span>
  </div>

  <!-- share bar -->
  <div class="share-bar">
    {audio && (
      <div class="listen" data-duration={audio.durationSec} data-timings={audio.timings}>
        <button type="button" class="listen-btn glass" aria-label={`Listen to this article, ${Math.max(1, Math.round(audio.durationSec / 60))} minutes`}>
          <svg class="listen-icon" data-icon="play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6a.6.6 0 0 0 .92.5l7.4-4.8a.6.6 0 0 0 0-1L5.92 2.7A.6.6 0 0 0 5 3.2Z" /></svg>
          <svg class="listen-icon" data-icon="pause" viewBox="0 0 16 16" aria-hidden="true" hidden><rect x="4" y="3" width="2.75" height="10" rx=".8" /><rect x="9.25" y="3" width="2.75" height="10" rx=".8" /></svg>
          <span class="listen-label">Listen · {Math.max(1, Math.round(audio.durationSec / 60))} min</span>
        </button>
        <div class="listen-controls" hidden>
          <input type="range" class="listen-seek" min="0" max={audio.durationSec} step="1" value="0" aria-label="Seek" />
          <span class="listen-time">0:00 / {fmtTime(audio.durationSec)}</span>
          <div class="listen-speed" role="radiogroup" aria-label="Playback speed">
            <span class="seg-thumb" aria-hidden="true"></span>
            {SPEEDS.map((rate) => (
              <label class="seg">
                <input type="radio" name="listen-speed" value={rate} checked={rate === 1} />
                <span>{rate}×</span>
              </label>
            ))}
          </div>
        </div>
        <audio src={audio.file} preload="none"></audio>
      </div>
    )}
    {post.data.medium_link && (
      <a href={post.data.medium_link} target="_blank" rel="noopener noreferrer" class="btn">
        Read on Medium ↗
      </a>
    )}
    <span class="share-divider" aria-hidden="true" />
    <span class="share-label">Share</span>
    <a href={`https://twitter.com/intent/tweet?text=${twitterText}&url=${pageUrl}`} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-icon share-icon" aria-label="Share on X">X</a>
    <a href={`https://linkedin.com/sharing/share-offsite/?url=${pageUrl}`} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-icon share-icon" aria-label="Share on LinkedIn">in</a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-icon share-icon" aria-label="Share on Facebook">f</a>
    <button onclick={`navigator.clipboard.writeText(window.location.href)`} class="btn-ghost btn-icon share-icon" aria-label="Copy link">⧉</button>
  </div>

  <!-- article header -->
  <header class="art-header">
    <div class="art-tags">
      {post.data.tags.map((t) => (
        <span class="badge">{t}</span>
      ))}
    </div>
    <h1 class="art-title">{post.data.title}</h1>
    <div class="art-meta mono">
      <span>{post.data.excerpt.split('—')[0]?.trim() ?? 'Article'}</span>
      <span>·</span>
      <span>{formattedDate}</span>
    </div>

    <!-- byline -->
    <div class="art-byline">
      <div class="byline-avatar">
        <img src="/memoji.png" alt="Ademola" style="width:100%;transform:scale(1.4) translateY(4px)" />
      </div>
      <div style="flex:1">
        <div class="byline-name">Ademola Kolawole</div>
        <div class="byline-role">Software engineer · Mobile &amp; backend</div>
      </div>
    </div>
  </header>

  <!-- featured image -->
  {post.data.image_url && (
    <div class="art-cover">
      <img src={post.data.image_url} alt={post.data.title} loading="lazy" decoding="async" />
    </div>
  )}

  <!-- body + toc -->
  <div class="art-layout">
    <article class="art-body prose">
      <Content />
    </article>

    {headings.length > 0 && (
      <aside class="art-toc" aria-label="Table of contents">
        <div class="toc-head section-label">Table of contents</div>
        <nav class="toc-nav">
          {headings.map((h) => (
            <a
              href={`#${h.slug}`}
              class={`tocitem toc-depth-${h.depth}`}
              data-depth={h.depth}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>

  <!-- reply CTA -->
  <div class="reply-cta card">
    <div class="reply-cta__inner">
      <div>
        <p class="reply-cta__label">Thoughts on this?</p>
        <p class="reply-cta__sub">Hit reply — I read every email.</p>
      </div>
      <a
        href={`mailto:hello@demola.dev?subject=Re: ${encodeURIComponent(post.data.title)}&body=Hi Ademola,%0A%0A`}
        class="glass reply-btn"
      >
        hello@demola.dev
      </a>
    </div>
  </div>

  <!-- comments -->
  <div class="comments-wrap">
    <Comments client:only="react" />
  </div>

  <!-- prev / next -->
  {(prev || next) && (
    <div class="art-prevnext">
      {prev ? (
        <a href={`/writing/${prev.slug}`} class="prevnext-link">
          <span class="prevnext-dir">← Previous</span>
          <span class="prevnext-title">{prev.data.title}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/writing/${next.slug}`} class="prevnext-link prevnext-link--right">
          <span class="prevnext-dir">Next →</span>
          <span class="prevnext-title">{next.data.title}</span>
        </a>
      ) : <div />}
    </div>
  )}

</BaseLayout>

<style>
  /* Breadcrumb status bar — a kept terminal touch */
  .art-statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-faint);
  }

  .art-back {
    font-size: 12px;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur-state) var(--ease-out);
  }
  .art-back:hover { color: var(--text-1); }
  .art-read { font-size: 12px; color: var(--text-2); }

  /* Share bar */
  .share-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 20px 0 0;
    flex-wrap: wrap;
  }

  .share-divider {
    width: 1px;
    height: 20px;
    background: var(--line);
    margin: 0 8px;
  }

  .share-label { font-size: 12px; color: var(--text-2); margin-right: 2px; }
  .share-icon { font-size: 13px; font-weight: 600; }

  /* Listen player — Glaze components; tokens and .glass come from global.css */
  .listen {
    font-family: var(--font-sans); /* the share bar around it is mono */
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  /* Once started, the controls sit in a shell card: depth inside the shape, no shadow. */
  .listen[data-active="true"] {
    padding: 4px 10px 4px 4px;
    border-radius: 14px;
    background: var(--shell);
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }
  .listen-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .listen-controls[hidden] { display: none; }

  .listen-btn { padding-left: 11px; }
  .listen-icon { width: 14px; height: 14px; fill: currentColor; flex: none; }
  .listen-icon[hidden] { display: none; }

  /* Slider: small glaze on the run and thumb, never glass */
  .listen-seek {
    --pct: 0%;
    -webkit-appearance: none;
    appearance: none;
    width: 180px;
    height: 16px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  .listen-seek::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 999px;
    background:
      linear-gradient(90deg, var(--glaze-sm-top), var(--glaze-sm-mid) 50%, var(--glaze-sm-bottom)) 0 0 / var(--pct) 100% no-repeat,
      var(--ink-10);
  }
  .listen-seek::-moz-range-track { height: 4px; border-radius: 999px; background: var(--ink-10); }
  .listen-seek::-moz-range-progress {
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--glaze-sm-top), var(--glaze-sm-mid) 50%, var(--glaze-sm-bottom));
  }
  .listen-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(var(--glaze-sm-top), var(--glaze-sm-mid) 50%, var(--glaze-sm-bottom));
    box-shadow: inset 0 1px 0 var(--glaze-sm-highlight), 0 0 0 .5px var(--glaze-sm-rim);
  }
  .listen-seek::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(var(--glaze-sm-top), var(--glaze-sm-mid) 50%, var(--glaze-sm-bottom));
    box-shadow: inset 0 1px 0 var(--glaze-sm-highlight), 0 0 0 .5px var(--glaze-sm-rim);
  }
  .listen-seek:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 999px; }

  .listen-time {
    font-family: var(--font-mono);
    font-size: 11.2px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    min-width: 9ch;
  }

  /* Segmented control: a paper thumb slides to the chosen speed */
  .listen-speed {
    position: relative;
    display: inline-flex;
    padding: 2px;
    border-radius: 999px;
    background: var(--ink-06);
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }
  .seg-thumb {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform .2s var(--ease-out), width .2s var(--ease-out);
  }
  .seg { position: relative; z-index: 1; display: flex; }
  .seg input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .seg span {
    display: flex;
    align-items: center;
    height: 26px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    transition: color .16s var(--ease-out);
  }
  .seg:hover span,
  .seg input:checked + span { color: var(--text-1); }
  .seg input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: -2px; }

  @media (prefers-reduced-motion: reduce) {
    .seg-thumb, .seg span { transition: none; }
  }
  @media (max-width: 600px) {
    .listen[data-active="true"], .listen-controls { width: 100%; }
    .listen-seek { flex: 1; width: auto; min-width: 120px; }
  }

  /* Reading highlight (word spans are created by the script below): a Glaze ink wash */
  :global(.rw) {
    border-radius: 4px;
    transition: background-color .16s cubic-bezier(.2, .8, .2, 1), box-shadow .16s cubic-bezier(.2, .8, .2, 1), color .16s;
  }
  :global(.rw-active) {
    background: #f4f4f326;
    box-shadow: 0 0 0 2px #f4f4f326;
    color: #f4f4f3;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rw) { transition: none; }
  }

  .share-icon {
    width: 34px;
    height: 34px;
    font-weight: 600;
  }


  /* Header */
  .art-header {
    padding: 28px 0 24px;
  }

  .art-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .art-title {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -.035em;
    color: var(--text-1);
    margin: 0 0 16px;
    max-width: 900px;
  }

  .art-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--text-2);
    flex-wrap: wrap;
  }

  /* Byline */
  .art-byline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line-faint);
  }

  .byline-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line-faint);
    flex-shrink: 0;
  }
  .byline-name { font-size: 14px; font-weight: 500; color: var(--text-1); }
  .byline-role { font-size: 12px; color: var(--text-2); }

  /* Cover image */
  .art-cover {
    margin: 0 0 32px;
    border-radius: var(--radius-shell);
    box-shadow: inset 0 0 0 1px var(--line-faint);
    overflow: hidden;
    background: var(--shell);
  }
  .art-cover img {
    width: 100%;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  /* Body + ToC grid */
  .art-layout {
    display: grid;
    grid-template-columns: 1fr 264px;
    gap: 44px;
    align-items: start;
    padding-bottom: 60px;
  }

  .art-body { min-width: 0; }

  /* ToC panel — items come from global.css */
  .art-toc {
    position: sticky;
    top: 24px;
    padding: 14px 10px;
    border-radius: var(--radius-panel);
    background: var(--shell);
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }

  .toc-head { padding: 0 10px; margin-bottom: 8px; }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Comments */
  .comments-wrap {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line-faint);
  }

  /* Reply card — its email button is the page's one glass action besides Listen */
  .reply-cta {
    margin: 48px 0 0;
    padding: 22px 24px;
  }

  .reply-cta__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .reply-cta__label {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-1);
    margin: 0 0 2px;
  }

  .reply-cta__sub {
    font-size: 14px;
    color: var(--text-2);
    margin: 0;
  }

  .reply-btn { margin-left: auto; }

  @media (max-width: 600px) {
    .reply-cta { padding: 18px; }
    .reply-btn { margin-left: 0; width: 100%; }
  }

  /* Prev / Next */
  .art-prevnext {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--line-faint);
    flex-wrap: wrap;
  }

  .prevnext-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    max-width: 42%;
  }

  .prevnext-link--right { align-items: flex-end; text-align: right; }
  .prevnext-dir { font-size: 12px; color: var(--text-2); }

  .prevnext-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-1);
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-state) var(--ease-out);
  }

  .prevnext-link:hover .prevnext-title { text-decoration-color: var(--line-strong); }

  /* Article prose — reading size (a builder's call in the spec) */
  :global(.prose) {
    color: var(--text-1);
    font-size: 17px;
    line-height: 1.75;
  }

  :global(.prose h2) {
    font-size: 28px;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.025em;
    margin: 48px 0 16px;
  }

  :global(.prose h3) {
    font-size: 20px;
    font-weight: 500;
    color: var(--text-1);
    margin: 36px 0 12px;
  }

  :global(.prose p) { margin: 0 0 22px; color: var(--text-1); }

  :global(.prose strong) { color: var(--text-1); font-weight: 600; }

  :global(.prose blockquote) {
    margin: 0 0 32px;
    padding: 2px 0 2px 24px;
    border-left: 1px solid var(--line-strong);
  }

  :global(.prose blockquote p) {
    font-size: 22px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.01em;
    margin: 0;
  }

  :global(.prose ul, .prose ol) {
    padding-left: 0;
    margin: 0 0 26px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.prose ul li) {
    padding-left: 18px;
    position: relative;
    color: var(--text-1);
  }
  :global(.prose ul li::before) {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--text-3);
  }

  :global(.prose ol) { counter-reset: li; }
  :global(.prose ol li) {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: var(--text-1);
  }
  :global(.prose ol li::before) {
    counter-increment: li;
    content: counter(li, decimal-leading-zero);
    flex: none;
    width: 28px;
    height: 28px;
    margin-top: 1px;
    border-radius: var(--radius-tag);
    background: var(--ink-06);
    box-shadow: inset 0 0 0 1px var(--line-faint);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 11.2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.prose img) {
    width: 100%;
    border-radius: var(--radius-overlay);
    box-shadow: inset 0 0 0 1px var(--line-faint);
    margin: 0 0 28px;
  }

  :global(.prose hr) {
    border: none;
    border-top: 1px solid var(--line-faint);
    margin: 40px 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .art-layout { grid-template-columns: 1fr; }
    .art-toc { display: none; }
  }

  @media (max-width: 600px) {
    .art-title { font-size: 30px; }
    .prevnext-link { max-width: 100%; }
  }
</style>

<script>
  // ── Terminal chrome for every <pre> in the article ──────────────────────────
  const LANG_MAP: Record<string, string> = {
    js: 'JavaScript', javascript: 'JavaScript',
    ts: 'TypeScript', typescript: 'TypeScript',
    dart: 'Dart', flutter: 'Dart',
    go: 'Go', golang: 'Go',
    py: 'Python', python: 'Python',
    kt: 'Kotlin', kotlin: 'Kotlin',
    swift: 'Swift',
    rust: 'Rust',
    sh: 'Shell', bash: 'Shell', shell: 'Shell', zsh: 'Shell',
    yaml: 'YAML', yml: 'YAML',
    json: 'JSON',
    sql: 'SQL',
    html: 'HTML', css: 'CSS',
    md: 'Markdown', markdown: 'Markdown',
    proto: 'Protobuf',
    toml: 'TOML',
    dockerfile: 'Dockerfile',
    plaintext: '', text: '', txt: '',
  };

  document.querySelectorAll<HTMLElement>('.art-body pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;

    // detect language from class e.g. "language-go" or "lang-go"
    const cls = Array.from(code.classList).find((c) => /^(language|lang)-/.test(c)) ?? '';
    const rawLang = cls.replace(/^(language|lang)-/, '').toLowerCase();
    const langLabel = LANG_MAP[rawLang] ?? (rawLang ? rawLang.toUpperCase() : '');

    // build line numbers
    const text = code.textContent ?? '';
    const lineCount = text.split('\n').filter((_, i, a) => i < a.length - 1 || a[i] !== '').length || 1;
    const lineNums = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');

    // wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';

    // chrome header
    const chrome = document.createElement('div');
    chrome.className = 'code-chrome';
    chrome.innerHTML = `
      <span class="code-dot" style="background:#ff5f56"></span>
      <span class="code-dot" style="background:#ffbd2e"></span>
      <span class="code-dot" style="background:#27c93f"></span>
      <span class="code-filename">${langLabel ? `${langLabel.toLowerCase()} snippet` : 'code'}</span>
      ${langLabel ? `<span class="code-lang">${langLabel}</span>` : ''}
      <button class="code-copy" aria-label="Copy code">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        copy
      </button>`;

    // copy handler
    const btn = chrome.querySelector<HTMLButtonElement>('.code-copy')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> copied!`;
        btn.classList.add('copied');
        setTimeout(() => {
          btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> copy`;
          btn.classList.remove('copied');
        }, 2200);
      } catch {
        btn.textContent = 'error';
      }
    });

    // inner: line numbers + code
    const inner = document.createElement('div');
    inner.className = 'code-inner';

    const nums = document.createElement('div');
    nums.className = 'code-lines';
    nums.textContent = lineNums;

    inner.appendChild(nums);
    inner.appendChild(pre.cloneNode(true));

    wrapper.appendChild(chrome);
    wrapper.appendChild(inner);

    pre.replaceWith(wrapper);
  });

  // ── Listen player ────────────────────────────────────────────────────────────
  const listen = document.querySelector<HTMLElement>('.listen');
  if (listen) {
    const audioEl = listen.querySelector('audio')!;
    const btn = listen.querySelector<HTMLButtonElement>('.listen-btn')!;
    const playIcon = listen.querySelector<SVGElement>('[data-icon="play"]')!;
    const pauseIcon = listen.querySelector<SVGElement>('[data-icon="pause"]')!;
    const label = listen.querySelector<HTMLElement>('.listen-label')!;
    const controls = listen.querySelector<HTMLElement>('.listen-controls')!;
    const seek = listen.querySelector<HTMLInputElement>('.listen-seek')!;
    const time = listen.querySelector<HTMLElement>('.listen-time')!;
    const speedGroup = listen.querySelector<HTMLElement>('.listen-speed')!;
    const speedThumb = listen.querySelector<HTMLElement>('.seg-thumb')!;
    const speedInputs = [...listen.querySelectorAll<HTMLInputElement>('.seg input')];
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const total = () => (Number.isFinite(audioEl.duration) ? audioEl.duration : Number(listen.dataset.duration));

    // Playback speed: a segmented control; the choice is remembered across articles.
    const SPEED_KEY = 'listen-speed';
    const placeThumb = () => {
      const chosen = speedInputs.find((i) => i.checked)?.parentElement;
      if (!chosen) return;
      speedThumb.style.width = `${chosen.offsetWidth}px`;
      speedThumb.style.transform = `translateX(${chosen.offsetLeft}px)`;
    };
    const applySpeed = (rate: number) => {
      audioEl.playbackRate = rate;
      audioEl.defaultPlaybackRate = rate;
      speedInputs.forEach((i) => { i.checked = Number(i.value) === rate; });
      placeThumb();
    };
    try {
      const saved = Number(localStorage.getItem(SPEED_KEY));
      if (speedInputs.some((i) => Number(i.value) === saved)) applySpeed(saved);
    } catch { /* storage unavailable: stay at 1× */ }
    speedGroup.addEventListener('change', (e) => {
      const rate = Number((e.target as HTMLInputElement).value);
      applySpeed(rate);
      try { localStorage.setItem(SPEED_KEY, String(rate)); } catch { /* not persisted */ }
    });
    window.addEventListener('resize', placeThumb);

    const setProgress = (seconds: number) => {
      seek.value = String(Math.floor(seconds));
      seek.style.setProperty('--pct', `${(seconds / total()) * 100}%`);
      seek.setAttribute('aria-valuetext', `${fmt(seconds)} of ${fmt(total())}`);
      time.textContent = `${fmt(seconds)} / ${fmt(total())}`;
    };

    const render = () => {
      const playing = !audioEl.paused;
      playIcon.toggleAttribute('hidden', playing);
      pauseIcon.toggleAttribute('hidden', !playing);
      label.textContent = playing ? 'Pause' : audioEl.currentTime > 0 ? 'Resume' : label.textContent;
      btn.setAttribute('aria-label', playing ? 'Pause narration' : 'Play narration');
    };

    btn.addEventListener('click', () => {
      if (controls.hidden) {
        controls.hidden = false;
        listen.dataset.active = 'true';
        // Place the thumb without animating it in from the left edge.
        speedThumb.style.transition = 'none';
        placeThumb();
        requestAnimationFrame(() => { speedThumb.style.transition = ''; });
      }
      if (audioEl.paused) {
        audioEl.play().catch(() => { label.textContent = 'Audio unavailable'; });
      } else {
        audioEl.pause();
      }
    });
    audioEl.addEventListener('play', render);
    audioEl.addEventListener('pause', render);
    audioEl.addEventListener('loadedmetadata', () => { seek.max = String(Math.floor(total())); });
    audioEl.addEventListener('timeupdate', () => setProgress(audioEl.currentTime));
    seek.addEventListener('input', () => {
      audioEl.currentTime = Number(seek.value);
      setProgress(Number(seek.value));
    });
    audioEl.addEventListener('ended', () => { audioEl.currentTime = 0; label.textContent = 'Listen again'; render(); });

    // ── Reading highlight ──────────────────────────────────────────────────────
    // On first play, wraps the article's words in spans and pairs them with the
    // narration's word timings (public/audio/<slug>.json, from `npm run audio`).
    const timingsUrl = listen.dataset.timings;
    const articleBody = document.querySelector<HTMLElement>('.art-body');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const norm = (w: string) => w.toLowerCase().replace(/[^\p{L}\p{N}]/gu, '');
    let spans: HTMLElement[] = []; // spans[i] is the word that starts at starts[i] ms
    let starts: number[] = [];
    let active: HTMLElement | null = null;
    let raf = 0;
    let prepared: Promise<void> | null = null;

    const wrapWords = (root: HTMLElement) => {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: (n) =>
          n.parentElement?.closest('pre, table, .code-block, script, style')
            ? NodeFilter.FILTER_REJECT
            : NodeFilter.FILTER_ACCEPT,
      });
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      const out: HTMLElement[] = [];
      for (const node of nodes) {
        if (!node.data.trim()) continue;
        const frag = document.createDocumentFragment();
        for (const part of node.data.split(/(\s+)/)) {
          if (!part) continue;
          if (/^\s+$/.test(part) || !norm(part)) {
            frag.appendChild(document.createTextNode(part));
          } else {
            const span = document.createElement('span');
            span.className = 'rw';
            span.textContent = part;
            frag.appendChild(span);
            out.push(span);
          }
        }
        node.replaceWith(frag);
      }
      return out;
    };

    // Pairs two nearly-identical word lists, skipping ahead on either side to get
    // past small differences (e.g. raw HTML in the article that isn't narrated).
    const alignWords = (a: string[], b: string[], window = 40) => {
      const pairs: [number, number][] = [];
      let i = 0;
      let j = 0;
      while (i < a.length && j < b.length) {
        if (a[i] === b[j]) { pairs.push([i++, j++]); continue; }
        const ai = a.slice(i + 1, i + 1 + window).indexOf(b[j]);
        const bj = b.slice(j + 1, j + 1 + window).indexOf(a[i]);
        if (ai !== -1 && (bj === -1 || ai <= bj)) i += ai + 1;
        else if (bj !== -1) j += bj + 1;
        else pairs.push([i++, j++]);
      }
      return pairs;
    };

    const prepare = () =>
      (prepared ??= (async () => {
        if (!timingsUrl || !articleBody) return;
        const res = await fetch(timingsUrl);
        if (!res.ok) return;
        const { words, t } = (await res.json()) as { words: string[]; t: number[] };
        const domWords = wrapWords(articleBody);
        for (const [x, y] of alignWords(words.map(norm), domWords.map((s) => norm(s.textContent ?? '')))) {
          starts.push(t[x]);
          spans.push(domWords[y]);
        }
      })().catch(() => { spans = []; starts = []; }));

    const onScreen = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.bottom > 0 && r.top < window.innerHeight;
    };

    const highlight = () => {
      const ms = audioEl.currentTime * 1000;
      let lo = 0;
      let hi = starts.length - 1;
      let idx = -1;
      while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        if (starts[mid] <= ms) { idx = mid; lo = mid + 1; } else { hi = mid - 1; }
      }
      const next = idx >= 0 ? spans[idx] : null;
      if (next === active) return;
      // Only follow along if the reader was still looking at the previous word.
      const following = !active || onScreen(active);
      active?.classList.remove('rw-active');
      next?.classList.add('rw-active');
      if (next && following && !onScreen(next)) {
        next.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
      }
      active = next;
    };

    const loop = () => {
      highlight();
      if (!audioEl.paused) raf = requestAnimationFrame(loop);
    };

    audioEl.addEventListener('play', () => {
      prepare().then(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); });
    });
    audioEl.addEventListener('seeked', () => { if (prepared) prepared.then(highlight); });
    audioEl.addEventListener('ended', () => {
      cancelAnimationFrame(raf);
      active?.classList.remove('rw-active');
      active = null;
    });
  }

  // ── ToC active highlight ─────────────────────────────────────────────────────
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.tocitem');
  if (tocLinks.length) {
    const headings = document.querySelectorAll<HTMLElement>('h2[id],h3[id],h4[id]');
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        const link = document.querySelector<HTMLAnchorElement>(`.tocitem[href="#${e.target.id}"]`);
        if (link) link.classList.toggle('active', e.isIntersecting);
      }),
      { rootMargin: '0px 0px -60% 0px' }
    );
    headings.forEach((h) => obs.observe(h));
  }
</script>
