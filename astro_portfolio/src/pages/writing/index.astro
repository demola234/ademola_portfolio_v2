---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="Writing — Ademola Kolawole" description="Deep-dives on systems, mobile internals, Go and software craft, plus personal essays.">
  <Nav />

  <div class="write-page">
    <header class="write-head">
      <p class="write-path mono">~/writing</p>
      <h1 class="write-h1">Writing.</h1>
      <p class="write-sub text-secondary">Deep-dives on systems, mobile internals, Go, software craft, and some emotional shit.</p>
    </header>

    <!-- Tag filter chips -->
    <div class="tag-bar" id="tag-bar" role="group" aria-label="Filter posts by tag">
      <button type="button" class="chip" data-tag="all" aria-pressed="true">all</button>
      {allTags.map((t) => (
        <button type="button" class="chip" data-tag={t} aria-pressed="false">{t}</button>
      ))}
    </div>

    <!-- Post list -->
    <div class="post-list" id="post-list">
      {posts.map((p) => (
        <a
          href={`/writing/${p.slug}`}
          class="post-row"
          data-tags={p.data.tags.join(',')}
        >
          <div class="post-row__meta mono">
            <span class="post-row__date text-secondary">
              {p.data.date.toLocaleDateString('en-US',{month:'short',year:'numeric'})}
            </span>
            <span class="post-row__min text-secondary">· {p.data.readMins} min</span>
          </div>
          <div class="post-row__body">
            <h2 class="post-row__title">{p.data.title}</h2>
            <p class="post-row__excerpt text-secondary">{p.data.excerpt}</p>
            <div class="post-row__tags">
              {p.data.tags.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
          <span class="post-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  const bar = document.getElementById('tag-bar');
  const list = document.getElementById('post-list');
  if (bar && list) {
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
      if (!btn) return;
      bar.querySelectorAll('[data-tag]').forEach((c) => c.setAttribute('aria-pressed', String(c === btn)));
      const tag = btn.dataset.tag ?? 'all';
      list.querySelectorAll<HTMLElement>('.post-row').forEach((row) => {
        const tags = row.dataset.tags?.split(',') ?? [];
        row.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none';
      });
    });
  }
</script>

<style>
  .write-page {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .write-head { margin-bottom: 36px; }

  .write-path {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .write-h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.035em;
    margin: 0 0 14px;
  }

  .write-sub {
    font-size: 16px;
    line-height: 1.6;
    max-width: 540px;
    margin: 0;
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 32px;
  }

  /* Glaze Item rows */
  .post-list {
    border-top: 1px solid var(--line-faint);
  }

  .post-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 22px 12px;
    border-bottom: 1px solid var(--line-faint);
    text-decoration: none;
    transition: background-color var(--dur-state) var(--ease-out);
  }

  .post-row:hover { background: var(--hover-row); }
  .post-row:hover .post-row__arrow { color: var(--text-1); }

  .post-row__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 90px;
    font-size: 11.2px;
    padding-top: 4px;
  }

  .post-row__body { flex: 1; min-width: 0; }

  .post-row__title {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-1);
    margin: 0 0 6px;
    line-height: 1.35;
    letter-spacing: -.01em;
  }

  .post-row__excerpt {
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .post-row__arrow {
    font-size: 18px;
    flex-shrink: 0;
    padding-top: 2px;
    color: var(--text-3);
    transition: color var(--dur-state) var(--ease-out);
  }

  @media (max-width: 600px) {
    .post-row { flex-direction: column; gap: 10px; }
    .post-row__meta { flex-direction: row; gap: 4px; }
    .post-row__arrow { display: none; }
  }
</style>
