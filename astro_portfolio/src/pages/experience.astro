---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import { experience } from '../data/Experience';

// Core principles — each one backed by something shipped (see src/data/Experience.ts)
const principles = [
  {
    title: 'Start from the problem, not the stack',
    body: 'I pick tools after I understand the constraint. That is how a QR payment system went from a blank page to $250K+ in monthly volume.',
  },
  {
    title: 'Design for the bad-network day',
    body: 'Real users are on weak signal and old phones. Queues, retries and circuit breakers keep analytics flowing for 25M+ users when the network does not cooperate.',
  },
  {
    title: 'Trust is a feature',
    body: 'In payments and identity, safety is the product. Anti-spoofing, KYC and geo-tagged audit trails cut card fraud by 25%.',
  },
  {
    title: 'Make quality measurable',
    body: 'If it is not measured, it is a feeling. Taking SDK test coverage from 4% to 76% and cutting crashes by 60% made quality something the team could see.',
  },
  {
    title: 'Leave the team faster than I found it',
    body: 'Automated CI/CD halved deployment time and a Compose migration cut UI complexity by 40%, so the next feature ships sooner.',
  },
];
---

<BaseLayout title="Experience — Ademola Kolawole" description="Mobile & backend engineering experience across fintech, identity, and payments.">
  <Nav />

  <div class="exp-page">
    <header class="exp-head">
      <p class="exp-path mono">~/experience</p>
      <h1 class="exp-h1">Where I've built.</h1>
      <p class="exp-sub text-secondary">5+ years of mobile-first engineering across fintech, identity, and payments. Here's the full timeline.</p>
    </header>

    <!-- Timeline -->
    <div class="timeline">
      {experience.map((exp, i) => (
        <div class="tl-row">
          <div class="tl-date-col">
            <span class="tl-date mono">{exp.dateRange}</span>
          </div>
          <div class="tl-spine">
            <div class={`tl-dot ${i === 0 ? 'tl-dot--now' : ''}`} />
            {i < experience.length - 1 && <div class="tl-line" />}
          </div>
          <div class="tl-content">
            <div class="tl-header">
              <h2 class="tl-role">{exp.role}</h2>
              <span class="tl-company">{exp.company}</span>
              <span class="tl-loc mono text-secondary">{exp.location}</span>
              <span class="tl-date-inline mono">{exp.dateRange}</span>
            </div>
            <ul class="tl-bullets">
              {exp.bullets.map((b) => (
                <li class="tl-bullet">{b}</li>
              ))}
            </ul>
            <div class="tl-stack">
              {exp.stack.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Principles -->
    <section class="principles-wrap" aria-labelledby="principles-h">
      <h2 id="principles-h" class="principles-h">How I work</h2>
      <ol class="principles">
        {principles.map(({ title, body }, i) => (
          <li class="principle">
            <span class="principle__num mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="principle__title">{title}</h3>
              <p class="principle__body">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <Footer />
</BaseLayout>

<style>
  .exp-page {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .exp-head {
    margin-bottom: 56px;
  }

  .exp-path {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .exp-h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.035em;
    margin: 0 0 14px;
  }

  .exp-sub {
    font-size: 16px;
    line-height: 1.6;
    max-width: 540px;
    margin: 0;
  }


  /* Principles — a numbered list on hairlines, not a row of cards */
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 40px;
    border-top: 1px solid var(--line-faint);
  }

  .principle {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-faint);
  }

  .principle__num { font-size: 12px; color: var(--text-3); padding-top: 3px; }

  .principle__title {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-1);
    margin: 0 0 6px;
    letter-spacing: -.01em;
  }

  .principle__body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-2);
    margin: 0;
  }

  .principles-wrap {
    margin-top: 16px;
    padding-top: 40px;
    border-top: 1px solid var(--line-faint);
  }

  .principles-h {
    font-size: 20px;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.01em;
    margin: 0 0 14px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .tl-row {
    display: grid;
    grid-template-columns: 170px 28px 1fr;
    gap: 0 16px;
  }

  .tl-date-col {
    display: flex;
    justify-content: flex-end;
    padding-top: 6px;
  }

  .tl-date {
    font-size: 11.2px;
    color: var(--text-2);
    text-align: right;
    line-height: 1.4;
  }

  .tl-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-32);
    flex-shrink: 0;
    margin-top: 8px;
  }
  .tl-dot--now { background: var(--text-1); }

  .tl-line {
    flex: 1;
    width: 1px;
    background: var(--line);
    margin-top: 6px;
  }

  .tl-content {
    padding-bottom: 48px;
  }

  .tl-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 12px;
  }

  .tl-role {
    font-size: 20px;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.01em;
    margin: 0;
  }

  .tl-company { font-size: 14px; font-weight: 500; color: var(--text-1); }

  .tl-loc { font-size: 11.2px; }

  .tl-date-inline {
    display: none;
    font-size: 11.2px;
    color: var(--text-2);
    width: 100%;
  }

  .tl-bullets {
    margin: 0 0 14px;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tl-bullet {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
    padding-left: 14px;
    position: relative;
  }

  .tl-bullet::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--text-3);
  }

  .tl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 700px) {
    .tl-row {
      grid-template-columns: 24px 1fr;
    }

    .tl-date-col { display: none; }
    .tl-date-inline { display: block; }
    .tl-content { padding-bottom: 36px; }

    .principles { grid-template-columns: 1fr; }
  }
</style>
