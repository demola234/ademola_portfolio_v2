---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import { experience } from '../data/Experience';

const education = {
  school: 'University of Ilorin',
  degree: 'B.Sc. Microbiology',
  dateRange: '2017 — 2022',
  location: 'Ilorin, Nigeria',
};

const stats = [
  { value: '5+', label: 'Years' },
  { value: '50M+', label: 'Users' },
  { value: '10+', label: 'Apps' },
  { value: '6', label: 'Companies' },
];
---

<BaseLayout title="Experience — Ademola Kolawole" description="Mobile & backend engineering experience across fintech, identity, and payments.">
  <Nav />

  <div class="exp-page">
    <header class="exp-head">
      <p class="exp-path mono">~/experience</p>
      <h1 class="exp-h1">Where I've built.</h1>
      <p class="exp-sub text-secondary">5+ years of mobile-first engineering across fintech, identity, and payments. Here's the full timeline.</p>
      <dl class="stats">
        {stats.map(({ value, label }) => (
          <div class="stat">
            <dt class="stat__label">{label}</dt>
            <dd class="stat__val">{value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- Timeline -->
    <div class="timeline">
      {experience.map((exp, i) => (
        <div class="tl-row">
          <div class="tl-date-col">
            <span class="tl-date mono">{exp.dateRange}</span>
          </div>
          <div class="tl-spine">
            <div class={`tl-dot ${i === 0 ? 'tl-dot--now' : ''}`} />
            {i < experience.length - 1 && <div class="tl-line" />}
          </div>
          <div class="tl-content">
            <div class="tl-header">
              <h2 class="tl-role">{exp.role}</h2>
              <span class="tl-company">{exp.company}</span>
              <span class="tl-loc mono text-secondary">{exp.location}</span>
              <span class="tl-date-inline mono">{exp.dateRange}</span>
            </div>
            <ul class="tl-bullets">
              {exp.bullets.map((b) => (
                <li class="tl-bullet">{b}</li>
              ))}
            </ul>
            <div class="tl-stack">
              {exp.stack.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}

      <!-- Education -->
      <div class="tl-row">
        <div class="tl-date-col">
          <span class="tl-date mono">{education.dateRange}</span>
        </div>
        <div class="tl-spine">
          <div class="tl-dot tl-dot--edu" />
        </div>
        <div class="tl-content">
          <div class="tl-header">
            <h2 class="tl-role">{education.degree}</h2>
            <span class="tl-company">{education.school}</span>
            <span class="tl-loc mono text-secondary">{education.location}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .exp-page {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .exp-head {
    margin-bottom: 56px;
  }

  .exp-path {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .exp-h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.035em;
    margin: 0 0 14px;
  }

  .exp-sub {
    font-size: 16px;
    line-height: 1.6;
    max-width: 540px;
    margin: 0 0 28px;
  }

  /* Figures in a row, split by hairlines — not a row of stat cards */
  .stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding: 0 24px;
    border-left: 1px solid var(--line-faint);
  }
  .stat:first-child { padding-left: 0; border-left: 0; }

  .stat__val {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }
  .stat__label { font-size: 12px; color: var(--text-2); }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .tl-row {
    display: grid;
    grid-template-columns: 170px 28px 1fr;
    gap: 0 16px;
  }

  .tl-date-col {
    display: flex;
    justify-content: flex-end;
    padding-top: 6px;
  }

  .tl-date {
    font-size: 11.2px;
    color: var(--text-2);
    text-align: right;
    line-height: 1.4;
  }

  .tl-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-32);
    flex-shrink: 0;
    margin-top: 8px;
  }
  .tl-dot--now { background: var(--text-1); }

  .tl-line {
    flex: 1;
    width: 1px;
    background: var(--line);
    margin-top: 6px;
  }

  .tl-content {
    padding-bottom: 48px;
  }

  .tl-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 12px;
  }

  .tl-role {
    font-size: 20px;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.01em;
    margin: 0;
  }

  .tl-company { font-size: 14px; font-weight: 500; color: var(--text-1); }

  .tl-loc { font-size: 11.2px; }

  .tl-date-inline {
    display: none;
    font-size: 11.2px;
    color: var(--text-2);
    width: 100%;
  }

  .tl-bullets {
    margin: 0 0 14px;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tl-bullet {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
    padding-left: 14px;
    position: relative;
  }

  .tl-bullet::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--text-3);
  }

  .tl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 700px) {
    .tl-row {
      grid-template-columns: 24px 1fr;
    }

    .tl-date-col { display: none; }
    .tl-date-inline { display: block; }
    .tl-content { padding-bottom: 36px; }

    .stat { padding: 0 16px; }
  }
</style>
