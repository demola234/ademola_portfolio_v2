---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="Projects — Ademola Kolawole" description="Apps and tools built by Ademola Kolawole.">
  <Nav />

  <div class="proj-page">
    <header class="proj-head">
      <p class="proj-path mono">~/projects</p>
      <h1 class="proj-h1">Things I've shipped.</h1>
      <p class="proj-sub text-secondary">Apps, tools, and experiments — from production fintech to dev utilities.</p>
    </header>

    <div class="proj-list">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}`} class="proj-row">
          <div class="proj-row__main">
            <h2 class="proj-row__title">{p.data.title}</h2>
            <p class="proj-row__desc text-secondary">{p.data.description}</p>
            <div class="proj-row__tags">
              {p.data.tags.map((t: string) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
          <span class="proj-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .proj-page {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .proj-head { margin-bottom: 40px; }

  .proj-path {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .proj-h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.035em;
    margin: 0 0 14px;
  }

  .proj-sub {
    font-size: 16px;
    line-height: 1.6;
    max-width: 540px;
    margin: 0;
  }

  /* Glaze Item rows */
  .proj-list {
    border-top: 1px solid var(--line-faint);
  }

  .proj-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 24px 12px;
    border-bottom: 1px solid var(--line-faint);
    text-decoration: none;
    transition: background-color var(--dur-state) var(--ease-out);
  }

  .proj-row:hover { background: var(--hover-row); }
  .proj-row:hover .proj-row__arrow { color: var(--text-1); }

  .proj-row__main { flex: 1; min-width: 0; }

  .proj-row__title {
    font-size: 20px;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.01em;
    margin: 0 0 6px;
  }

  .proj-row__desc {
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 12px;
  }

  .proj-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .proj-row__arrow {
    font-size: 18px;
    flex-shrink: 0;
    color: var(--text-3);
    transition: color var(--dur-state) var(--ease-out);
  }
</style>
