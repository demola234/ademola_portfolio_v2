---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, subtitle, description, tags, image_url, github, play_store, app_store } = project.data;
// The first available link is the page's one lead (glass) action; the rest are flat.
const links = [
  github && { href: github, label: 'GitHub' },
  play_store && { href: play_store, label: 'Play Store' },
  app_store && { href: app_store, label: 'App Store' },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout
  title={`${title} — Ademola Kolawole`}
  description={description}
  ogImage={image_url}
>
  <Nav />

  <div class="proj-detail">
    <a href="/projects" class="back-link btn-ghost btn-sm">← Projects</a>

    <header class="proj-header">
      <p class="section-label">{subtitle}</p>
      <h1 class="proj-title">{title}</h1>
      <p class="proj-desc text-secondary">{description}</p>

      <div class="proj-meta">
        <div class="proj-tags">
          {tags.map((t: string) => <span class="badge">{t}</span>)}
        </div>

        <div class="proj-links">
          {links.map(({ href, label }, i) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class={i === 0 ? 'glass' : 'btn'}>
              {label} ↗
            </a>
          ))}
        </div>
      </div>
    </header>

    {image_url && (
      <div class="proj-img-wrap">
        <img
          src={image_url}
          alt={title}
          class="proj-img"
          loading="lazy"
          decoding="async"
          width="1120"
          height="630"
        />
      </div>
    )}

    <div class="proj-body prose">
      <Content />
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .proj-detail {
    padding-block: 32px 0;
    max-width: 800px;
  }

  .back-link {
    margin: 0 0 32px -10px;
  }

  .proj-header { margin-bottom: 40px; }

  .proj-title {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-block: 10px 14px;
  }

  .proj-desc {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .proj-meta {
    display: flex;
    align-items: center;
    gap: 16px 20px;
    flex-wrap: wrap;
  }

  .proj-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .proj-links { display: flex; gap: 8px; flex-wrap: wrap; }

  .proj-img-wrap {
    margin-bottom: 48px;
    border-radius: var(--radius-shell);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }

  .proj-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .proj-body { max-width: 100%; }
</style>
