---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
---

<BaseLayout title="404 — Page Not Found" description="This page doesn't exist.">
  <Nav />

  <div class="not-found">
    <!-- Terminal window -->
    <div class="terminal">
      <div class="terminal__chrome">
        <span class="dot" style="background:#ff5f56" />
        <span class="dot" style="background:#ffbd2e" />
        <span class="dot" style="background:#27c93f" />
        <span class="terminal__title mono">bash — not-found</span>
      </div>

      <div class="terminal__body">
        <div class="terminal__line">
          <span class="prompt mono"><span class="prompt__dir">~/demola.dev</span> <span class="prompt__sym">$</span></span>
          <span class="mono cmd" id="cmd-text"></span><span class="cur" id="cursor" aria-hidden="true" />
        </div>

        <div class="terminal__output" id="output" aria-live="polite"></div>
      </div>
    </div>

    <!-- 404 code -->
    <div class="nf-code" aria-label="404">
      <span class="nf-num mono">4</span>
      <span class="nf-num nf-num--mid mono">0</span>
      <span class="nf-num mono">4</span>
    </div>

    <p class="not-found__msg text-secondary">
      This route doesn't exist. Maybe it was moved, deleted, or never shipped.
    </p>

    <div class="not-found__actions">
      <a href="/" class="glass">← go home</a>
      <a href="/writing" class="btn">read something →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 72vh;
    padding: 60px 0;
    text-align: center;
    gap: 32px;
  }

  /* Terminal window — a kept terminal touch */
  .terminal {
    width: 100%;
    max-width: 560px;
    border-radius: var(--radius-overlay);
    overflow: hidden;
    background: var(--shell);
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }

  .terminal__chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line-faint);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal__title {
    margin-left: 8px;
    font-size: 11.2px;
    color: var(--text-2);
  }

  .terminal__body {
    padding: 18px 20px 22px;
    text-align: left;
    min-height: 120px;
  }

  .terminal__line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    line-height: 20px;
    margin-bottom: 8px;
  }

  .prompt { display: flex; gap: 6px; align-items: center; white-space: nowrap; font-size: 12px; }
  .prompt__dir { color: var(--text-1); }
  .prompt__sym { color: var(--text-3); }

  .cmd {
    font-size: 12px;
    color: var(--text-1);
  }

  .cur {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--text-1);
    vertical-align: -2px;
    animation: blink 1.1s steps(1) infinite;
    margin-left: 2px;
  }

  @keyframes blink { 0%,49%{opacity:1} 50%,100%{opacity:0} }

  .terminal__output {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
    white-space: pre-wrap;
    min-height: 60px;
  }

  /* Status colours only where they mean status: the error and the exit code */
  :global(.terminal__output .err)  { color: var(--fail-text); }
  :global(.terminal__output .warn) { color: var(--warn-text); }
  :global(.terminal__output .acc)  { color: var(--text-1); }

  /* Big 404 */
  .nf-code {
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .nf-num {
    font-size: clamp(96px, 18vw, 160px);
    font-weight: 500;
    letter-spacing: -.05em;
    color: var(--ink-10);
    cursor: default;
    user-select: none;
  }

  .nf-num--mid { color: var(--ink-32); }

  /* Message */
  .not-found__msg {
    font-size: 16px;
    line-height: 1.6;
    max-width: 400px;
    margin: 0;
  }

  /* Actions — one glass lead, one flat */
  .not-found__actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>

<script>
  const CMD   = 'cd /pages/this-route';
  const LINES = [
    { text: `bash: cd: /pages/this-route: No such file or directory`, cls: 'err' },
    { text: `` },
    { text: `<span class="acc">suggestion</span>  try one of these instead:`, cls: '' },
    { text: `  <span class="acc">→</span>  /             home` },
    { text: `  <span class="acc">→</span>  /projects     shipped work` },
    { text: `  <span class="acc">→</span>  /writing      articles` },
    { text: `  <span class="acc">→</span>  /notes        quick thoughts` },
    { text: `  <span class="acc">→</span>  /experience   timeline` },
    { text: `` },
    { text: `<span class="warn">exit code 1</span>` },
  ];

  const cmdEl    = document.getElementById('cmd-text')!;
  const cursor   = document.getElementById('cursor')!;
  const outputEl = document.getElementById('output')!;

  let i = 0;

  // Type the command
  function typeCmd() {
    if (i < CMD.length) {
      cmdEl.textContent += CMD[i++];
      setTimeout(typeCmd, 48 + Math.random() * 30);
    } else {
      cursor.style.display = 'none';
      setTimeout(printOutput, 320);
    }
  }

  // Print output lines one by one
  function printOutput() {
    let li = 0;
    function next() {
      if (li >= LINES.length) return;
      const div = document.createElement('div');
      div.innerHTML = LINES[li].text;
      outputEl.appendChild(div);
      li++;
      setTimeout(next, 55);
    }
    next();
  }

  // Start after a short delay
  setTimeout(typeCmd, 600);
</script>
