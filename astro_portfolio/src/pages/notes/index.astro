---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(notes.flatMap((n) => n.data.tags ?? []))].sort();
---

<BaseLayout title="Notes — Ademola Kolawole" description="Quick thoughts, TILs, and engineering observations.">
  <Nav />

  <div class="notes-page">
    <header class="notes-head">
      <p class="notes-path mono">~/notes</p>
      <h1 class="notes-h1" data-scramble aria-label="Notes."><span class="scr" aria-hidden="true">Notes.</span></h1>
      <p class="notes-sub text-secondary">Quick thoughts, TILs, and observations from building mobile & backend systems.</p>
    </header>

    <!-- Tag filter -->
    <div class="tag-bar" id="tag-bar" role="group" aria-label="Filter notes by tag">
      <button type="button" class="chip" data-tag="all" aria-pressed="true">all</button>
      {allTags.map((t) => (
        <button type="button" class="chip" data-tag={t} aria-pressed="false">{t}</button>
      ))}
    </div>

    <!-- Notes grid -->
    <div class="notes-grid" id="notes-grid">
      {notes.map(async (note) => {
        // Long note: has excerpt set OR body > 800 chars → link to full page
        const rawBody = note.body ?? '';
        const isLong = !!note.data.excerpt || rawBody.length > 800;
        const preview = note.data.excerpt ?? rawBody
          .split('\n')
          .filter((l) => !l.startsWith('#') && !l.startsWith('`') && l.trim())
          .join(' ')
          .slice(0, 200) + '…';

        const { Content } = isLong ? { Content: null } : await note.render();
        const dateLabel = note.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
        const tagStr = (note.data.tags ?? []).join(',');
        const { book } = note.data;
        if (book) return (
          <a href={`/notes/${note.slug}`} class="note-card card note-card--linked book-card" data-tags={tagStr}>
            <div class="book-card__shelf">
              <Image src={book.cover} alt="" width={240} class="book-cover book-card__cover" />
            </div>
            <div class="book-card__inner">
              <div class="note-card__header">
                <span class="note-card__date mono">{dateLabel}</span>
                <span class:list={['badge', { 'badge--reading': book.status === 'reading' }]}>{book.status}</span>
              </div>
              <h2 class="book-card__title">{book.title}</h2>
              <p class="book-card__author">{book.author}</p>
              {note.data.excerpt && <p class="note-preview">{note.data.excerpt}</p>}
              <span class="note-read">read note →</span>
            </div>
          </a>
        );
        return (
          <div class="note-card card" class:list={[{ 'note-card--linked': isLong }]} data-tags={tagStr}>
            <div class="note-card__header">
              <span class="note-card__date mono">{dateLabel}</span>
              <div class="note-card__tags">
                {(note.data.tags ?? []).map((t) => (
                  <span class="badge">{t}</span>
                ))}
              </div>
            </div>
            {isLong ? (
              <a href={`/notes/${note.slug}`} class="note-link-body">
                <p class="note-preview">{preview}</p>
                <span class="note-read">read note →</span>
              </a>
            ) : (
              <div class="note-card__body prose-note">
                <Content />
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  import { scrambleHeadings } from '../../scripts/scramble';
  scrambleHeadings();

  const bar = document.getElementById('tag-bar');
  const grid = document.getElementById('notes-grid');
  if (bar && grid) {
    const select = (btn: HTMLElement) => {
      bar.querySelectorAll('[data-tag]').forEach((c) => c.setAttribute('aria-pressed', String(c === btn)));
      const tag = btn.dataset.tag ?? 'all';
      grid.querySelectorAll<HTMLElement>('.note-card').forEach((card) => {
        const tags = card.dataset.tags?.split(',') ?? [];
        card.hidden = !(tag === 'all' || tags.includes(tag));
      });
    };
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
      if (btn) select(btn);
    });
    // Deep link: /notes?tag=Books (the home page's "bookshelf →")
    const initial = new URLSearchParams(location.search).get('tag');
    const initialBtn = initial && [...bar.querySelectorAll<HTMLElement>('[data-tag]')].find((b) => b.dataset.tag === initial);
    if (initialBtn) select(initialBtn);
  }
</script>

<style>
  .notes-page {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .notes-head { margin-bottom: 32px; }

  .notes-path {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .notes-h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -.035em;
    margin: 0 0 14px;
  }

  .notes-sub {
    font-size: 16px;
    line-height: 1.6;
    max-width: 540px;
    margin: 0;
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 32px;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 12px;
  }

  .note-card { padding: 20px 22px; }
  .note-card--linked:hover { background: var(--flat-hover); }

  .note-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .note-card__date { font-size: 11.2px; color: var(--text-2); }

  .note-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .note-link-body {
    display: block;
    text-decoration: none;
  }

  .note-preview {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-1);
    margin: 0 0 14px;
  }

  .note-read {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    transition: color var(--dur-state) var(--ease-out);
  }

  .note-link-body:hover .note-read { color: var(--text-1); }

  /* Book notes — cover-forward card */
  .note-card[hidden] { display: none; }
  .book-card {
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }
  .book-card__shelf {
    display: flex;
    justify-content: center;
    padding: 24px 0 20px;
    background: linear-gradient(180deg, var(--field), transparent);
  }
  .book-card__cover { width: 120px; }
  .book-card__inner { padding: 16px 22px 20px; }
  .book-card__title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-1);
    margin: 0;
  }
  .book-card__author {
    font-size: 12.5px;
    color: var(--text-3);
    margin: 2px 0 10px;
  }
  .book-card:hover .note-read { color: var(--text-1); }

  /* Prose for notes — plain body text, inline code only */
  :global(.prose-note p) {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-1);
    margin: 0;
  }

  :global(.prose-note code) {
    font-family: var(--font-mono);
    font-size: .8em;
    background: var(--ink-06);
    color: var(--text-1);
    padding: 1px 6px;
    border-radius: var(--radius-tag);
  }

  @media (max-width: 600px) {
    .notes-grid { grid-template-columns: 1fr; }
  }
</style>
