---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await note.render();
const dateLabel = note.data.date.toLocaleDateString('en-US', {
  weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
});
const { book } = note.data;
const pageTitle = book
  ? `${book.title} by ${book.author}`
  : note.data.excerpt?.split('—')[0]?.trim() ?? note.slug;
---

<BaseLayout
  title={`${pageTitle} — Notes`}
  description={note.data.excerpt}
>
  <Nav />

  <div class="note-page">
    <a href="/notes" class="back btn-ghost btn-sm">← notes</a>

    <header class:list={['note-head', { 'note-head--book': book }]}>
      {book && (
        <Image src={book.cover} alt={`Cover of ${book.title}`} width={320} class="book-cover note-book__cover" />
      )}
      <div class="note-head__text">
      {book && (
        <>
          <span class:list={['badge', { 'badge--reading': book.status === 'reading' }]}>{book.status}</span>
          <h1 class="note-book__title">{book.title}</h1>
          <p class="note-book__author">{book.author}</p>
        </>
      )}
      <div class="note-meta">
        <span class="note-date mono">{dateLabel}</span>
        {(note.data.tags ?? []).map((t) => (
          <span class="badge">{t}</span>
        ))}
      </div>
      {note.data.excerpt && (
        <p class="note-excerpt text-secondary">{note.data.excerpt}</p>
      )}
      </div>
    </header>

    <div class="note-layout">
      <div class="note-body prose">
        <Content />
      </div>

      {headings.length > 2 && (
        <aside class="note-toc">
          <div class="toc-head section-label">On this page</div>
          <nav>
            {headings.map((h) => (
              <a href={`#${h.slug}`} class={`tocitem toc-depth-${h.depth}`}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .note-page {
    padding-top: 28px;
    padding-bottom: 64px;
  }

  .back { margin: 0 0 28px -10px; }

  .note-head { margin-bottom: 36px; }
  .note-head--book {
    display: flex;
    gap: 32px;
    align-items: flex-end;
  }
  .note-book__cover { width: 160px; flex-shrink: 0; }
  .note-book__title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.1;
    color: var(--text-1);
    margin: 12px 0 4px;
  }
  .note-book__author { font-size: 15px; color: var(--text-3); margin: 0 0 14px; }
  @media (max-width: 600px) {
    .note-head--book { flex-direction: column; align-items: flex-start; gap: 20px; }
    .note-book__cover { width: 120px; }
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .note-date { font-size: 11.2px; color: var(--text-2); margin-right: 4px; }

  .note-excerpt {
    font-size: 17px;
    line-height: 1.6;
    max-width: 680px;
    margin: 0;
  }

  .note-layout {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 44px;
    align-items: start;
  }

  .note-body { min-width: 0; }

  /* ToC panel — items come from global.css */
  .note-toc {
    position: sticky;
    top: 24px;
    padding: 14px 10px;
    border-radius: var(--radius-panel);
    background: var(--shell);
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }

  .toc-head { padding: 0 10px; margin-bottom: 8px; }

  /* Prose */
  :global(.note-body.prose) { font-size: 17px; line-height: 1.75; color: var(--text-1); max-width: 68ch; }
  :global(.note-body.prose h2) { font-size: 24px; font-weight: 500; color: var(--text-1); letter-spacing: -.02em; margin: 44px 0 14px; }
  :global(.note-body.prose h3) { font-size: 20px; font-weight: 500; color: var(--text-1); margin: 32px 0 10px; }
  :global(.note-body.prose h4) { font-size: 16px; font-weight: 500; color: var(--text-1); margin: 24px 0 8px; }
  :global(.note-body.prose p) { margin: 0 0 18px; color: var(--text-1); }
  :global(.note-body.prose hr) { border: none; border-top: 1px solid var(--line-faint); margin: 36px 0; }
  :global(.note-body.prose strong) { color: var(--text-1); font-weight: 600; }
  :global(.note-body.prose blockquote) {
    margin: 0 0 24px;
    padding: 2px 0 2px 20px;
    border-left: 1px solid var(--line-strong);
  }
  :global(.note-body.prose blockquote p) { color: var(--text-1); margin: 0; }
  :global(.note-body.prose ul) { padding-left: 0; margin: 0 0 20px; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  :global(.note-body.prose ul li) { padding-left: 16px; position: relative; color: var(--text-1); }
  :global(.note-body.prose ul li::before) { content: '–'; position: absolute; left: 0; color: var(--text-3); }
  :global(.note-body.prose ol) { margin: 0 0 20px; list-style: decimal; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  :global(.note-body.prose ol li) { color: var(--text-1); padding-left: 4px; }
  :global(.note-body.prose ol li::marker) { color: var(--text-3); }
  :global(.note-body.prose table) { width: 100%; border-collapse: collapse; margin: 0 0 24px; font-size: 14px; }
  :global(.note-body.prose th) { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); color: var(--text-2); font-size: 12px; font-weight: 500; }
  :global(.note-body.prose td) { padding: 8px 12px; border-bottom: 1px solid var(--line-faint); color: var(--text-1); }
  :global(.note-body.prose tr:hover td) { background: var(--hover-row); }
  :global(.note-body.prose img) { width: 100%; border-radius: var(--radius-overlay); box-shadow: inset 0 0 0 1px var(--line-faint); margin: 0 0 24px; }

  @media (max-width: 1024px) {
    .note-layout { grid-template-columns: 1fr; }
    .note-toc { display: none; }
  }
</style>

<script>
  // Code block chrome — same terminal treatment as articles
  const LANG_MAP: Record<string, string> = {
    js:'JavaScript', ts:'TypeScript', dart:'Dart', go:'Go', golang:'Go',
    py:'Python', python:'Python', kt:'Kotlin', swift:'Swift', rust:'Rust',
    sh:'Shell', bash:'Shell', yaml:'YAML', yml:'YAML', json:'JSON',
    sql:'SQL', toml:'TOML', dockerfile:'Dockerfile', plaintext:'', text:'',
  };

  document.querySelectorAll<HTMLElement>('.note-body pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;
    const cls = Array.from(code.classList).find((c) => /^(language|lang)-/.test(c)) ?? '';
    const rawLang = cls.replace(/^(language|lang)-/, '').toLowerCase();
    const langLabel = LANG_MAP[rawLang] ?? (rawLang ? rawLang.toUpperCase() : '');
    const lineCount = (code.textContent ?? '').split('\n').filter((_, i, a) => i < a.length - 1 || a[i] !== '').length || 1;
    const lineNums = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';

    const chrome = document.createElement('div');
    chrome.className = 'code-chrome';
    chrome.innerHTML = `
      <span class="code-dot" style="background:#ff5f56"></span>
      <span class="code-dot" style="background:#ffbd2e"></span>
      <span class="code-dot" style="background:#27c93f"></span>
      <span class="code-filename">${langLabel ? `${langLabel.toLowerCase()} snippet` : 'code'}</span>
      ${langLabel ? `<span class="code-lang">${langLabel}</span>` : ''}
      <button class="code-copy" aria-label="Copy">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        copy
      </button>`;

    chrome.querySelector<HTMLButtonElement>('.code-copy')!.addEventListener('click', async () => {
      const btn = chrome.querySelector<HTMLButtonElement>('.code-copy')!;
      await navigator.clipboard.writeText(code.textContent ?? '');
      btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> copied!`;
      btn.classList.add('copied');
      setTimeout(() => { btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> copy`; btn.classList.remove('copied'); }, 2200);
    });

    const inner = document.createElement('div');
    inner.className = 'code-inner';
    const nums = document.createElement('div');
    nums.className = 'code-lines';
    nums.textContent = lineNums;
    inner.appendChild(nums);
    inner.appendChild(pre.cloneNode(true));
    wrapper.appendChild(chrome);
    wrapper.appendChild(inner);
    pre.replaceWith(wrapper);
  });

  // ToC highlight
  const links = document.querySelectorAll<HTMLAnchorElement>('.tocitem');
  if (links.length) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        const link = document.querySelector<HTMLAnchorElement>(`.tocitem[href="#${e.target.id}"]`);
        if (link) link.classList.toggle('active', e.isIntersecting);
      }),
      { rootMargin: '0px 0px -60% 0px' }
    );
    document.querySelectorAll<HTMLElement>('h2[id],h3[id],h4[id]').forEach((h) => obs.observe(h));
  }
</script>
