---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import AsciiPortrait from '../components/AsciiPortrait.tsx';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const selectedWork = allProjects.slice(0, 3).map((p, i) => ({
  num: String(i + 1).padStart(2, '0'),
  title: p.data.title,
  sub: p.data.subtitle,
  stack: p.data.tags.slice(0, 3).join(' · '),
  slug: p.slug,
}));

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const stack = [
  { name: 'Flutter',  src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/flutter/flutter-original.svg' },
  { name: 'Dart',     src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dart/dart-original.svg' },
  { name: 'Swift',    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/swift/swift-original.svg' },
  { name: 'Kotlin',   src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg' },
  { name: 'Go',       src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original.svg' },
  { name: 'Rust',     src: 'https://cdn.simpleicons.org/rust/ffffff', mono: true },
  { name: 'Android',  src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/android/android-original.svg' },
  { name: 'iOS',      src: 'https://cdn.simpleicons.org/apple/ffffff', mono: true },
  { name: 'Firebase', src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/firebase/firebase-original.svg' },
  { name: 'Postgres', src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg' },
  { name: 'Redis',    src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/redis/redis-original.svg' },
  { name: 'MongoDB',  src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg' },
  { name: 'Kafka',    src: 'https://cdn.simpleicons.org/apachekafka/ffffff', mono: true },
  { name: 'Docker',   src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg' },
  { name: 'Actions',  src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/githubactions/githubactions-original.svg' },
  { name: 'Grafana',  src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/grafana/grafana-original.svg' },
];

const allNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = allNotes.slice(0, 4);

const youtube = [
  { title: 'Flutter Bunny: Generate Flutter Models from JSON in Seconds', views: '31 views', ago: '10 months ago', duration: '1:05',
    videoId: '8gB2kwDhWxo',
    preview: '~ flutter_bunny\nFlutter Bunny CLI — set up your Flutter project\n\nUsage: flutter_bunny <command> [arguments]\n\nAvailable commands:\n  create    Create a new Flutter app\n  generate  Generate components from JSON' },
  { title: 'Flutter Bunny CLI: Create Production-Ready Flutter Apps in 30 Seconds', views: '248 views', ago: '10 months ago', duration: '2:33',
   videoId: 'jLXJmlkI3nw',
    preview: '~ flutter_bunny\nFlutter Bunny CLI — Let\'s set up your project\n\n$ flutter_bunny create\n\n? App name › my_app\n? Architecture › Clean Architecture\n? State mgmt › Riverpod\n✓ Production-ready app in 30s' },
];
---

<BaseLayout title="Ademola Kolawole — Product Engineer">

  <!-- Status bar -->
  <div class="status-bar mono">
    <span>demola.dev</span>
  </div>

  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div class="hero__text">
      <div class="hero__label mono">Product Engineer · Mobile &amp; Platform</div>
      <h1 class="hero__h1" id="hero-name" aria-label="Ademola Kolawole"><span class="scr" aria-hidden="true">Ademola</span><br><span class="hero__h1-dim scr" aria-hidden="true">Kolawole</span></h1>
      <p class="hero__body">
        I turn hard product problems into mobile software people trust with their <strong>money and identity</strong>: fraud-resistant payments, face-verified onboarding, and analytics that survive bad networks. I design the system and build it in <strong class="lang-cycle" data-words="Dart,Kotlin,Swift,Go,Rust"><span class="sr-only">Dart, Kotlin, Swift, Go and Rust</span><span class="lang-cycle__word" aria-hidden="true">Dart</span></strong>, shipping on <strong>Flutter, Android &amp; iOS</strong> for products serving <strong>50M+ users</strong>.
      </p>
    </div>
    <div class="hero__img-col" aria-hidden="true">
      <div class="hero__img-card">
        <AsciiPortrait
          client:only="react"
          size={300}
          sources={[
            { src: '/portrait/portrait.webm', type: 'video/webm' },
            { src: '/portrait/portrait.mp4', type: 'video/mp4' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="section" style="padding-top:30px">
    <div class="section-row" style="margin-bottom:22px">
      <span class="path-label mono">~/stack</span>
      <span class="section-hint">the tools I build with</span>
    </div>
    <div class="stack-row">
      {stack.map(({ name, src, mono }) => (
        <div class={`stackicon ${mono ? 'stackicon--mono' : ''}`} title={name}>
          <div class="stackicon__box">
            <img src={src} alt={name} width="32" height="32" loading="lazy" decoding="async" />
          </div>
          <span class="stackicon__label">{name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Writing preview -->
  <section class="section">
    <div class="section-row">
      <span class="path-label mono">~/writing</span>
      <a href="/writing" class="btn-ghost btn-sm">all posts →</a>
    </div>
    <div class="row-list">
      {posts.map((p) => (
        <a href={`/writing/${p.slug}`} class="rowa post-row">
          <span class="post-row__title">{p.data.title}</span>
          <span class="post-row__meta mono">
            {p.data.date.toLocaleDateString('en-US',{month:'short',year:'numeric'})} · {p.data.readMins} min
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Selected work -->
  <section class="section">
    <div class="section-row">
      <span class="path-label mono">~/selected-work</span>
      <a href="/projects" class="btn-ghost btn-sm">all projects →</a>
    </div>
    <div class="row-list">
      {selectedWork.map(({ num, title, sub, stack: st, slug }) => (
        <a href={`/projects/${slug}`} class="rowa work-row">
          <span class="work-row__num mono">{num}</span>
          <span class="work-row__info">
            <span class="work-row__title">{title}</span>
            <br />
            <span class="work-row__sub">{sub}</span>
          </span>
          <span class="mono text-secondary work-row__stack">{st}</span>
          <span class="arw" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Notes -->
  <section class="section">
    <div class="section-row" style="margin-bottom:14px">
      <span class="path-label mono">~/notes</span>
      <a href="/notes" class="btn-ghost btn-sm">all notes →</a>
    </div>
    <div class="notes-grid">
      {notes.map((note) => {
        const dateLabel = note.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
        // Use excerpt if set, otherwise strip markdown and truncate
        const raw = note.body.split('\n').filter(l => !l.startsWith('#') && !l.startsWith('`') && l.trim()).join(' ');
        const preview = note.data.excerpt ?? (raw.slice(0, 160) + '…');
        return (
          <a href="/notes" class="note-card card">
            <div class="note-card__date mono">{dateLabel}</div>
            <p class="note-card__body">{preview}</p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- YouTube -->
  <section class="section">
    <div class="section-row" style="margin-bottom:14px">
      <span class="path-label mono">~/youtube</span>
      <a href="https://youtube.com/@CodeWithDemola" target="_blank" rel="noopener noreferrer" class="btn-ghost btn-sm">@CodeWithDemola ↗</a>
    </div>
    <div class="yt-grid">
      {youtube.map(({ title, views, ago, duration, preview, videoId }) => (
        <button class="yt-card card" data-video-id={videoId} data-title={title} aria-label={`Play ${title}`}>
          <div class="yt-card__thumb">
            <img
              src={`https://img.youtube.com/vi/${videoId}/hqdefault.jpg`}
              alt={title}
              class="yt-card__thumb-img"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
            />
            <pre class="yt-card__preview mono" style="display:none">{preview}</pre>
            <div class="yt-play">
              <div class="yt-play__btn">
                <span class="yt-play__arrow" aria-hidden="true" />
              </div>
            </div>
            <span class="yt-duration mono">{duration}</span>
          </div>
          <div class="yt-card__body">
            <h3 class="yt-card__title">{title}</h3>
            <span class="yt-card__meta">{views} · {ago}</span>
          </div>
        </button>
      ))}
    </div>

    <!-- Video overlay modal -->
    <div id="yt-modal" class="yt-modal" role="dialog" aria-modal="true" aria-label="Video player" hidden>
      <div class="yt-modal__backdrop" id="yt-backdrop" />
      <div class="yt-modal__window">
        <div class="yt-modal__chrome">
          <div class="yt-modal__dots">
            <span class="yt-modal__dot" style="background:#ff5f56" />
            <span class="yt-modal__dot" style="background:#ffbd2e" />
            <span class="yt-modal__dot" style="background:#27c93f" />
          </div>
          <span class="yt-modal__title mono" id="yt-modal-title"></span>
          <button class="yt-modal__close btn-ghost btn-icon btn-sm" id="yt-close" aria-label="Close video">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" /></svg>
          </button>
        </div>
        <div class="yt-modal__player">
          <iframe
            id="yt-iframe"
            src=""
            title="YouTube video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Footer inline -->
  <footer class="home-footer">
    <span class="home-footer__cta">
      <span class="home-footer__lead">let's build</span>
      <a href="mailto:hello@demola.dev" class="glass">hello@demola.dev</a>
    </span>
    <div class="home-footer__links">
      {[
        { label: 'github',   href: 'https://github.com/demola234' },
        { label: 'x',        href: 'https://twitter.com/demola234' },
        { label: 'linkedin', href: 'https://linkedin.com/in/ademola-kolawole' },
        { label: 'youtube',  href: 'https://youtube.com/@CodeWithDemola' },
      ].map(({ label, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-sm">{label}</a>
      ))}
    </div>
  </footer>

</BaseLayout>

<script>
  import { scramble } from '../scripts/scramble';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Name: churns through asterisks on hover, then settles ────────────────────
  const nameEl = document.getElementById('hero-name');
  if (nameEl && !reduceMotion) {
    const lines = [...nameEl.querySelectorAll<HTMLElement>('.scr')];
    const texts = lines.map((l) => l.textContent ?? '');
    let busy = false;
    nameEl.addEventListener('pointerenter', async () => {
      if (busy) return;
      busy = true;
      // Hold each line's width so the heading does not jitter while glyphs swap.
      lines.forEach((l) => { l.style.width = `${l.getBoundingClientRect().width}px`; });
      await Promise.all(lines.map((l, i) => new Promise<void>((done) => {
        setTimeout(() => scramble(l, texts[i], { stagger: 55, churn: 260 }).then(done), i * 120);
      })));
      lines.forEach((l) => { l.style.width = ''; });
      busy = false;
    });
  }

  // ── Languages: cycle Dart → Kotlin → Swift → Go → Rust with the same scramble ─
  const cycle = document.querySelector<HTMLElement>('.lang-cycle');
  const wordEl = cycle?.querySelector<HTMLElement>('.lang-cycle__word');
  if (cycle && wordEl) {
    const words = (cycle.dataset.words ?? '').split(',');
    if (reduceMotion) {
      wordEl.textContent = 'Dart, Kotlin, Swift, Go & Rust';
    } else {
      let i = 0;
      setInterval(() => {
        if (document.hidden) return;
        i = (i + 1) % words.length;
        scramble(wordEl, words[i], { stagger: 50, churn: 180 });
      }, 2400);
    }
  }

  // ── YouTube modal ────────────────────────────────────────────────────────────
  const modal    = document.getElementById('yt-modal') as HTMLElement;
  // Move modal to <body> so position:fixed is never trapped inside a transformed parent
  document.body.appendChild(modal);

  const iframe   = document.getElementById('yt-iframe') as HTMLIFrameElement;
  const titleEl  = document.getElementById('yt-modal-title') as HTMLElement;
  const closeBtn = document.getElementById('yt-close') as HTMLButtonElement;
  const backdrop = document.getElementById('yt-backdrop') as HTMLElement;

  function openModal(videoId: string, title: string) {
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
    titleEl.textContent = title;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.hidden = true;
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.videoId ?? '';
      const title = btn.dataset.title ?? '';
      openModal(id, title);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

</script>

<style>
  /* Status bar — a kept terminal touch */
  .status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-faint);
    font-size: 12px;
    color: var(--text-2);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 44px;
    padding: 48px 0 36px;
    align-items: center;
  }

  .hero__label {
    font-size: 12px;
    color: var(--text-2);
    margin-bottom: 18px;
  }

  .hero__h1 {
    font-size: 78px;
    line-height: .95;
    font-weight: 500;
    margin: 0;
    letter-spacing: -.035em;
    color: var(--text-1);
  }

  .hero__h1-dim { color: var(--text-3); }

  .scr {
    display: inline-block;
    white-space: nowrap;
    cursor: default;
  }

  .lang-cycle__word { white-space: nowrap; }

  .hero__body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 540px;
    margin: 26px 0 0;
  }
  .hero__body strong { color: var(--text-1); font-weight: 500; }

  .hero__img-col {
    position: relative;
    flex-shrink: 0;
  }

  .hero__img-card {
    border-radius: var(--radius-shell);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--line-faint);
  }

  /* Section shared */
  .section {
    padding-top: 28px;
    border-top: 1px solid var(--line-faint);
    margin-top: 28px;
  }

  .section-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .path-label {
    font-size: 12px;
    color: var(--text-3);
  }

  .section-hint {
    font-size: 12px;
    color: var(--text-3);
  }

  /* Item rows */
  .row-list { border-top: 1px solid var(--line-faint); }

  .rowa {
    display: flex;
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
    transition: background-color var(--dur-state) var(--ease-out);
  }
  .rowa:hover { background: var(--hover-row); }
  .rowa:hover .arw { color: var(--text-1); }
  .arw {
    font-size: 18px;
    color: var(--text-3);
    transition: color var(--dur-state) var(--ease-out);
  }

  .post-row {
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 16px 12px;
  }
  .post-row__title { font-size: 16px; font-weight: 500; color: var(--text-1); }
  .post-row__meta { font-size: 12px; color: var(--text-2); white-space: nowrap; }

  /* Work rows */
  .work-row {
    display: grid;
    grid-template-columns: 44px 1fr 210px 30px;
    gap: 20px;
    align-items: center;
    padding: 20px 12px;
  }

  .work-row__num { font-size: 12px; color: var(--text-3); }
  .work-row__title { font-size: 20px; font-weight: 500; color: var(--text-1); letter-spacing: -.01em; }
  .work-row__sub { font-size: 14px; color: var(--text-2); }
  .work-row__stack { font-size: 11.2px; color: var(--text-2); }

  /* Stack icons — monochrome, no lift */
  .stack-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(74px, 1fr));
    gap: 26px 16px;
    border-top: 1px solid var(--line-faint);
    padding-top: 28px;
  }

  .stackicon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    cursor: default;
  }

  .stackicon__box {
    width: 58px;
    height: 58px;
    border-radius: var(--radius-panel);
    background: var(--shell);
    box-shadow: inset 0 0 0 1px var(--line-faint);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--dur-state) var(--ease-out);
  }
  .stackicon:hover .stackicon__box { background: var(--flat-hover); }

  .stackicon__box img {
    width: 30px;
    height: 30px;
    filter: grayscale(1) brightness(1.6);
    opacity: .85;
  }
  .stackicon--mono .stackicon__box img { filter: grayscale(1) brightness(1.9); }

  .stackicon__label {
    font-size: 12px;
    color: var(--text-2);
    transition: color var(--dur-state) var(--ease-out);
  }
  .stackicon:hover .stackicon__label { color: var(--text-1); }

  /* Notes */
  .notes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .note-card {
    display: block;
    padding: 18px 20px;
    text-decoration: none;
  }
  .note-card__date { font-size: 11.2px; color: var(--text-2); margin-bottom: 8px; }
  .note-card__body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-1);
    margin: 0;
  }
  .note-card__body :global(code) {
    font-family: var(--font-mono);
    font-size: .8em;
    background: var(--ink-06);
    color: var(--text-1);
    padding: 1px 6px;
    border-radius: var(--radius-tag);
  }

  /* YouTube */
  .yt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .yt-card {
    overflow: hidden;
    display: block;
    text-align: left;
    width: 100%;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    color: inherit;
  }
  .yt-card:hover { background: var(--flat-hover); }

  .yt-card__thumb {
    position: relative;
    height: 162px;
    background: var(--page);
    border-bottom: 1px solid var(--line-faint);
    overflow: hidden;
  }

  .yt-card__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(1);
    opacity: .9;
  }

  .yt-card__preview {
    margin: 0;
    padding: 14px 16px;
    font-size: 10px;
    line-height: 1.75;
    color: var(--text-3);
    white-space: pre-wrap;
    overflow: hidden;
    position: absolute;
    inset: 0;
  }

  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .yt-play__btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #0c0c0cb3;
    box-shadow: inset 0 0 0 1px var(--line);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--dur-state) var(--ease-out);
  }
  .yt-card:hover .yt-play__btn { background: #0c0c0ce6; }

  .yt-play__arrow {
    width: 0;
    height: 0;
    border-left: 14px solid var(--text-1);
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    margin-left: 4px;
  }

  .yt-duration {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: #0c0c0ccc;
    color: var(--text-1);
    font-size: 11.2px;
    padding: 2px 6px;
    border-radius: var(--radius-tag);
  }

  .yt-card__body { padding: 14px 18px 16px; }
  .yt-card__title {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 6px;
    color: var(--text-1);
    line-height: 1.35;
  }
  .yt-card__meta { font-size: 12px; color: var(--text-2); }

  /* Video dialog — Glaze overlay; the Mac window dots are a kept terminal touch */
  .yt-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .yt-modal[hidden] { display: none; }

  .yt-modal__backdrop {
    position: absolute;
    inset: 0;
    background: var(--scrim);
    cursor: pointer;
    animation: overlayFade var(--dur-overlay) var(--ease-out) both;
  }

  .yt-modal__window {
    position: relative;
    width: 100%;
    max-width: 860px;
    margin: auto;
    border-radius: var(--radius-overlay);
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
